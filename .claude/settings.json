{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(/runs/**)",
      "Agent",
      "Skill",
      "Monitor"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Edit(/servers.json)",
      "Edit(/executer/**)",
      "Edit(/agent/generators/**)",
      "Edit(/.git/**)",
      "EnterWorktree"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": [
        "./executer",
        "./agent/generators",
        "./servers.json",
        "./.git"
      ],
      "denyRead": [
        "./.env",
        "./.env.*"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|Edit|Write|NotebookEdit|Bash|PowerShell|Monitor|Agent|EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_project_writes.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/trace_hook.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/trace_hook.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/trace_hook.py\""
          }
        ]
      }
    ]
  }
}
