def _build_grouped_matmul_v5_group_list_cumsum(m, group_count, device=None):
    """Build deterministic type-0 group boundaries ending at M."""
    m = int(m)
    group_count = int(group_count)
    if m < 0:
        raise ValueError("GroupedMatmulV5 M must be non-negative")
    if group_count <= 0:
        raise ValueError("GroupedMatmulV5 group count must be positive")

    base, remainder = divmod(m, group_count)
    group_sizes = torch.full(
        (group_count,), base, dtype=torch.int64, device=device
    )
    if remainder:
        group_sizes[:remainder] += 1
    return torch.cumsum(group_sizes, dim=0)


def _prepare_grouped_matmul_v5_type0_group_list(
        x_value, weight_value, group_list, group_type, group_list_type):
    """Materialise type-0 content only for the verified A8W8 scope."""
    def single_tensor(value):
        if isinstance(value, torch.Tensor):
            return value
        if (isinstance(value, (list, tuple)) and len(value) == 1
                and isinstance(value[0], torch.Tensor)):
            return value[0]
        return None

    x_tensor = single_tensor(x_value)
    weight_tensor = single_tensor(weight_value)
    in_supported_scope = (
        group_type == 0
        and group_list_type == 0
        and isinstance(x_tensor, torch.Tensor)
        and x_tensor.dim() == 2
        and x_tensor.dtype == torch.int8
        and isinstance(weight_tensor, torch.Tensor)
        and weight_tensor.dim() == 3
        and weight_tensor.dtype == torch.int8
        and isinstance(group_list, torch.Tensor)
        and group_list.dtype == torch.int64
    )
    if not in_supported_scope:
        return group_list

    group_count = int(weight_tensor.shape[0])
    if group_list.numel() != group_count:
        raise ValueError(
            "GroupedMatmulV5 groupListOptional length must equal "
            f"weight group count E ({group_count}), got {group_list.numel()}"
        )
    return _build_grouped_matmul_v5_group_list_cumsum(
        x_tensor.shape[0], group_count, group_list.device
    ).reshape(group_list.shape)


