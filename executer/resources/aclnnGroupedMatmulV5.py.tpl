            if (group_type == 0
                    and self._int4_config_dtype("x") == "int8"
                    and self._int4_config_dtype("weight") == "int4"
                    and input_data.kwargs is not None
                    and "perTokenScaleOptional" not in input_data.kwargs):
                x_probe = runtime_value("x")
