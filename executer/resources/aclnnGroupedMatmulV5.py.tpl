def _int4_nibble_wrap(tensor):
    """Fold int values into signed INT4 range [-8, 7] as torch.int8.

    ATK materialises "int4" case data as torch.int32 logical values (one
    nibble value per element, logical shape), so no nibble unpack happens
    anywhere. Both NPU and CPU paths only need this value fold before the
    2-nibbles-per-byte packing done by create_int4_acl_tensor.
    """
    if not isinstance(tensor, torch.Tensor):
        return tensor
    value = torch.remainder(tensor.to(torch.int64), 16)
    value = torch.where(value >= 8, value - 16, value)
    return value.to(torch.int8)


def _int4_nibble_wrap_value(value):
    """List-aware _int4_nibble_wrap for runtime tensor-list values."""
    if isinstance(value, torch.Tensor):
        return _int4_nibble_wrap(value)
    if isinstance(value, list):
        return [_int4_nibble_wrap_value(item) for item in value]
    if isinstance(value, tuple):
        return tuple(_int4_nibble_wrap_value(item) for item in value)
    return value


def _grouped_matmul_v5_a4w4_scale(scale_tensor, weight_matmul):
    """Broadcast A4W4 scaleOptional onto the dequantised weight layout.

    perchannel [E,N] -> [E,1,N]; pergroup [E,G,N] -> [E,K,N] with the
    K axis repeated per group. weight_matmul must already be in its
    logical (E,K,N) matmul layout.
    """
    if scale_tensor is None:
        return None
    if not isinstance(scale_tensor, torch.Tensor):
        raise TypeError("GroupedMatmulV5 scaleOptional must be a tensor")
    value = scale_tensor.float()
    k_total = weight_matmul.shape[-2]
    if value.dim() == 2:                       # perchannel [E,N]
        return value.unsqueeze(-2)
    if value.dim() == 3:                       # pergroup [E,G,N]
        groups = value.shape[1]
        if groups <= 0 or k_total % groups != 0:
            raise ValueError(
                "GroupedMatmulV5 A4W4 pergroup scale requires K divisible "
                f"by G (K={k_total}, G={groups})"
            )
        per_group = k_total // groups
        # [E,G,N] -> [E,K,N]（rank-3，与 weight 逐元素对齐）；保留 rank-4
        # [E,K,1,N] 会与 rank-3 weight 右对齐广播错位（E 维撞 K 维）。
        return value.unsqueeze(2).repeat_interleave(per_group, dim=1).squeeze(2)
    raise ValueError(
        "GroupedMatmulV5 A4W4 scaleOptional must be rank-2 [E,N] or rank-3 "
        f"[E,G,N], got rank {value.dim()}"
    )


