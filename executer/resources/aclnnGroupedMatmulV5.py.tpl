                else:
                    input_args.append(ctypes.c_void_p(None))

        output_list = self.output.split(',')
        for index, output in enumerate(output_list):
            data = input_tmp.get(output)
            if isinstance(data, list):
                output_packages.append(data[0])
            else:
                output_packages.append(data)

        return input_args, output_packages

    def after_call(self, output_packages):
        output = []
        for output_pack in output_packages:
            if isinstance(output_pack, AclTensorStruct):
                output.append(self.acl_tensor_to_torch(output_pack))
            elif isinstance(output_pack, AclTensorlistStruct):
                output.append(self.acl_tensorlist_to_torch(output_pack))
        return output

    def _x_transposed_presentation(self):
        """gt=2 split-K：x 需以非连续转置张量呈现（x_transposed 卡为真）。"""
        found = self.get_config_by_name(
            self.task_result.case_config.inputs, "x_transposed"
        )
        if found is None:
            return False
        value = getattr(found, "range_values", None)
        while isinstance(value, list) and len(value) == 1:
            value = value[0]
        return bool(value)

    def get_storage_shape(self, input_data: InputDataset, index=None, name=None):
        if name == "x" and self._x_transposed_presentation():
            # 转置呈现：storage 必须上报物理 S（≠ 逻辑 view L）。远端 atk
            # create_acl_tensor 在 storage_shape 缺省时取 view shape（探测源码
            # acl_wrapper.py:298-299），storage==view 会被宿主 CheckCaseSplitK
            # 判为非转置呈现——20260911 run 四变体全败的根因即 storage==view。
            found = self.get_config_by_name(self.task_result.case_config.inputs, name)
            if isinstance(found, list) and found:
                found = found[0]
            if (found is not None and not isinstance(found, list)
                    and found.shape is not None):
                return torch.Size(found.shape)
        if name is not None:
            found = self.get_config_by_name(self.task_result.case_config.inputs, name)
            if (found is not None and not isinstance(found, list)
                    and found.shape is not None):
                return torch.Size(found.shape)
        return None

    def get_format(self, input_data: InputDataset, index=None, name=None):
        found = None
        if name is not None:
            found = self.get_config_by_name(self.task_result.case_config.inputs, name)
        if found is not None and not isinstance(found, list):
            format = found.format
            return self.get_acl_format(format)
        return AclFormat.ACL_FORMAT_ND

    def get_cpp_func_signature_type(self):
        return "aclnnStatus aclnnGroupedMatmulV5GetWorkspaceSize( const aclTensorList *x, const aclTensorList *weight, const aclTensorList *biasOptional, const aclTensorList *scaleOptional, const aclTensorList *offsetOptional, const aclTensorList *antiquantScaleOptional, const aclTensorList *antiquantOffsetOptional, const aclTensorList *perTokenScaleOptional, const aclTensor *groupListOptional, const aclTensorList *activationInputOptional, const aclTensorList *activationQuantScaleOptional, const aclTensorList *activationQuantOffsetOptional, int64_t splitItem, int64_t groupType, int64_t groupListType, int64_t actType, aclIntArray *tuningConfigOptional, aclTensorList *out, aclTensorList *activationFeatureOutOptional, aclTensorList *dynQuantScaleOutOptional, uint64_t *workspaceSize, aclOpExecutor **executor)"

    def get_param_names_excluding_last_two(self, func_str):
        match = re.search(r'\(([^)]*)\)', func_str)
        if not match:
            return []

        params_str = match.group(1)
        param_names = []
        for param in params_str.split(','):
            param = param.strip()
            name_match = re.search(r'\*?\s*(\w+)\s*$', param)
            if name_match:
                param_names.append(name_match.group(1))

        if "GetWorkspaceSize" in func_str:
            return param_names[:-2] if len(param_names) >= 2 else param_names
        else:
            return param_names


    def handle_attr_param(self, input_tmp, param_list):
        for config in self.task_result.case_config.inputs:
            if not isinstance(config, list):
                if config.name not in param_list:
                    continue
                if config.type == "attr":
                    range_val = config.range_values[0] if isinstance(config.range_values, list) else config.range_values
                    ctype = self.get_ctype(config.dtype)
                    if ctype == ctypes.c_char_p:
                        range_val = range_val.encode('utf-8')
                    input_tmp[config.name] = [ctype(range_val)]
            else:
                data = []
                data_name = config[0].name
                if data_name not in param_list:
                    continue
                for config_item in config:
                      if config_item.type == "attrs" or config_item.type == "attr_tuple":
                          range_val = config_item.range_values
                          if isinstance(range_val, list):
                              range_val = range_val[0] if range_val else None
                          if range_val is None:
                              AclIntArrayPtr = ctypes.POINTER(AclIntArray)
                              null_void_ptr = ctypes.c_void_p(None)
                              null_array_ptr = ctypes.cast(null_void_ptr, AclIntArrayPtr)
                              input_tmp[data_name] = null_array_ptr
                              break
                          data.append(self.get_ctype(config_item.dtype)(range_val))
                          input_tmp[data_name] = nnopbase.create_x_list(data)

    def handle_special_param(self, operator_name, input_data):
        if "aclnnGroupedMatmulV5" in operator_name:
            def case_scalar(name, default=None):
                config = self.get_config_by_name(
                    self.task_result.case_config.inputs, name
                )
                value = getattr(config, "range_values", None)
                while isinstance(value, list) and len(value) == 1:
                    value = value[0]
                return default if value is None or isinstance(value, list) else value

            group_type = case_scalar("groupType")
            found_weight_transposed = self.get_config_by_name(
                self.task_result.case_config.inputs, "weight_transposed"
            )
            weight_transposed = False
            if found_weight_transposed is not None:
                value = getattr(found_weight_transposed, "range_values", None)
                if isinstance(value, list):
                    value = value[0] if value else False
                if value is not None:
                    weight_transposed = bool(value)

            flat_configs = []
            for item in self.task_result.case_config.inputs:
                if isinstance(item, (list, tuple)):
                    flat_configs.extend(item)
                else:
                    flat_configs.append(item)

            def config_indexes(name):
                return [
                    index for index, config in enumerate(flat_configs)
                    if (config is not None and hasattr(config, "name")
                        and config.name == name)
                ]

            def runtime_value(name):
                if input_data.kwargs and name in input_data.kwargs:
                    return input_data.kwargs[name]
                indexes = config_indexes(name)
                values = [
                    input_data.args[index] for index in indexes
                    if index < len(input_data.args)
                ]
                if len(values) == 1:
                    return values[0]
                return values or None

            def replace_runtime_value(name, value):
                if input_data.kwargs and name in input_data.kwargs:
                    input_data.kwargs[name] = value
                    return True
                indexes = config_indexes(name)
                if len(indexes) == 1 and indexes[0] < len(input_data.args):
                    input_data.args[indexes[0]] = value
                    return True
                return False

            # A8W4 伪量化多 Tensor 折叠为单 3-D 张量（源码验证，
            # operators-src/gmm/grouped_matmul）：
            # - 宿主/tiling/内核全部按 TensorList[0] 的单张量布局线性寻址：
            #   tiling 取 groupNum=weight[0].dim(0)、quantGroupNum=scale[0].dim(1)、
            #   n=scale[0].dim(2)（grouped_matmul_tiling.cpp:1851-1855）；内核按
            #   groupIdx*n*k 线性偏移读 weight（antiquant_a8w4.h:236-258）。
            # - 多 Tensor 2-D weight（E 个独立 (K,N)）传入时 tiling 把
            #   weight[0].dim(0)=K 当 groupNum、scale[0].dim(1) 当 quantGroupNum、
            #   读越界 dim 当 n → 多重 GM 越界 → MTE invalid GM address
            #   （EZ9999 aicore exception）级联崩溃。A2 宿主检查全为 OP_LOGW
            #   警告不拦截（CheckA8W4SymmQuantParams），须在 executor 侧物化。
            # - 文档合法形态：weight (E,K,N)、scale (E,quantGroupNum,N)（offset
            #   为空）/ (E,1,N)（offset 不为空）、bias (E,N)、offset (E,1,N)。
            #   把 E 个等形 rank-2/rank-1 张量按 dim0 stack 即得。CPU golden
            #   侧收到的是未折叠原始数据（A4W4 x-wrap 同理），multi-weight
            #   路径不受影响；仅当形状不齐/不匹配时跳过折叠，交 NPU 参数
            #   检查产生明确失败供诊断。
            if (group_type == 0
                    and self._int4_config_dtype("x") == "int8"
                    and self._int4_config_dtype("weight") == "int4"):
                def fold_tensor_list(name, item_rank):
                    value = runtime_value(name)
                    if not (isinstance(value, (list, tuple)) and value
                            and all(isinstance(t, torch.Tensor)
                                    for t in value)):
                        return
                    if not all(t.dim() == item_rank for t in value):
                        return
                    if len({tuple(t.shape) for t in value}) != 1:
                        return
                    # ATK 签名校验（check_signature_type_diff）要求
                    # weight/scale/bias/offset 位置传 LP_AclTensorList，
                    # 单张量会被拒（位置 2-5 类型不匹配）；故折叠产物包成
                    # 单元素 TensorList——签名过 list 检查，宿主 tiling 读
                    # weight[0].dim(0)=E（groupNum）也是正确的单张量视图。
                    replace_runtime_value(
                        name, [torch.stack(list(value), dim=0)]
                    )

                fold_tensor_list("scaleOptional", 2)   # E×(G,N) -> [(E,G,N)]
                fold_tensor_list("biasOptional", 1)    # E×(N,)  -> [(E,N)]
                fold_tensor_list("offsetOptional", 2)  # E×(1,N) -> [(E,1,N)]
                fold_tensor_list("weight", 2)          # E×(K,N) -> [(E,K,N)]

            def prepare_weight_tensor(tensor):
                return _prepare_grouped_matmul_v5_weight(
                    tensor, group_type, weight_transposed
                )

            def prepare_weight_value(value):
                if isinstance(value, torch.Tensor):
                    return prepare_weight_tensor(value)
                if isinstance(value, list):
                    return [prepare_weight_tensor(item) for item in value]
                if isinstance(value, tuple):
                    return tuple(prepare_weight_tensor(item) for item in value)
                return value

            handled_in_kwargs = bool(
                input_data.kwargs and "weight" in input_data.kwargs
            )
            if handled_in_kwargs:
                input_data.kwargs["weight"] = prepare_weight_value(
                    input_data.kwargs["weight"]
                )
            elif input_data.args:
                weight_indexes = [
                    index for index, config in enumerate(flat_configs)
                    if (config is not None and hasattr(config, "name")
                        and config.name == "weight")
                ]
                for index in weight_indexes:
                    if index < len(input_data.args):
                        input_data.args[index] = prepare_weight_value(
                            input_data.args[index]
                        )

            # gt=2 split-K x 转置呈现（文档场景表：gt=2 x 必须转置；宿主
            # CheckCaseSplitK 校验）。cases 层 x 存物理 S + is_transpose/
            # transpose_id（permute(S, perm) == 逻辑 view L）；此处把 x 还原为
            # L 的非连续 view（strides 经 convert_input_data → create_acl_tensor
            # 传导给 ACL 描述符），storage 侧由 get_storage_shape 对转置 x
            # 上报物理 S（storage≠view 才构成宿主认可的转置呈现）。
            if self._x_transposed_presentation():
                def permute_x_tensor(tensor):
                    if not isinstance(tensor, torch.Tensor) or tensor.dim() < 2:
                        return tensor
                    found_x = self.get_config_by_name(
                        self.task_result.case_config.inputs, "x"
                    )
                    if isinstance(found_x, list) and found_x:
                        found_x = found_x[0]
                    perm = getattr(found_x, "transpose_id", None) \
                        if found_x is not None else None
                    if isinstance(perm, (list, tuple)) \
                            and len(perm) == tensor.dim():
                        return tensor.permute(*[int(p) for p in perm])
                    # 配置未透传 transpose_id 时的等价回退：末两维转置
                    # （gt=2 x 为 rank-2 (K,M) 存储，等价 perm [1,0]）。
                    return tensor.transpose(-1, -2)

                x_runtime = runtime_value("x")
                x_items = (
                    list(x_runtime) if isinstance(x_runtime, (list, tuple))
                    else [x_runtime]
                )
                if x_items and all(
                        isinstance(t, torch.Tensor) for t in x_items):
                    permuted = [permute_x_tensor(t) for t in x_items]
                    replace_runtime_value(
                        "x",
                        permuted if isinstance(x_runtime, (list, tuple))
                        else permuted[0],
                    )

            # A4W4 x 物化：ATK 以 torch.int32 逻辑值生成 int4 数据，先折算
            # 到 [-8,7] 的 int8，init_by_input_data 再打包为 ACL_INT4。
            # 须在 groupList 物化前完成，使作用域检查按 int8 命中。
            if self._int4_config_dtype("x") == "int4":
                x_runtime = runtime_value("x")
                if x_runtime is not None:
                    replace_runtime_value(
                        "x", _int4_nibble_wrap_value(x_runtime)
                    )

            # A4W4 内核缺陷补偿：文档声明 perTokenScaleOptional 可选，宿主
            # CheckA4W4 对 null 合法放行且直接把 nullptr 透传给内核
            # （IsEmpty() ? nullptr），但 GMMA4W4Compute 内核无条件执行
            # perTokenScaleGm SetGlobalBuffer + DataCopyPad 读取，null 时
            # 即 "MTE accesses an invalid GM address" 崩溃。此处当 A4W4 且
            # 用例未提供 perTokenScale 时物化全 1 的 fp32 [M] 张量（乘 1
            # 恒等，数值语义不变；宿主要求 1 维且长度=x 的 M）。
            if (self._int4_config_dtype("x") == "int4"
                    and self._int4_config_dtype("weight") == "int4"
                    and input_data.kwargs is not None
                    and "perTokenScaleOptional" not in input_data.kwargs):
                x_probe = runtime_value("x")
                if isinstance(x_probe, (list, tuple)):
                    x_probe = x_probe[0] if len(x_probe) == 1 else None
                if isinstance(x_probe, torch.Tensor) and x_probe.dim() >= 2:
                    input_data.kwargs["perTokenScaleOptional"] = [
                        torch.ones(
                            int(x_probe.shape[0]), dtype=torch.float32
                        )
                    ]

            # A8W4 内核缺陷补偿（源码验证）：与 A4W4 同族——MSD/ND 模板
            # DataCopyPerTokenScaleAndBrcb 无条件 perTokenScaleGm
            # SetGlobalBuffer + DataCopyPad 读取（antiquant_a8w4.h:346、
            # msd.h:450，无 null 守卫），宿主 perTokenScale 为空时把
            # nullptr 透传给内核（aclnn_grouped_matmul.cpp:2318）→ MTE
            # invalid GM address 崩溃。且非对称分支（offsetOptional (E,1,N)
            # 非空）宿主硬检查要求 perTokenScale 非空、fp32 且 shape
            # (M,1) rank-2（CheckA8W4AsymQuantParams /
            # CheckA8W4AsymQuantParamsRelationship，aclnn:963-1023）；对称
            # 分支仅 LOGW（dim[0]==M 即可通过）。此处当 A8W4 且用例未提供
            # perTokenScale 时物化全 1 的 fp32 (M,1) 张量（乘 1 恒等，数值
            # 语义不变）；用户显式提供的 perTokenScale 原样透传（如 rank-1
            # (M,) 会按宿主硬检查明确拒绝，留给约束诊断）。
            if (group_type == 0
                    and self._int4_config_dtype("x") == "int8"
                    and self._int4_config_dtype("weight") == "int4"
                    and input_data.kwargs is not None
                    and "perTokenScaleOptional" not in input_data.kwargs):
                x_probe = runtime_value("x")
                if isinstance(x_probe, (list, tuple)):
                    x_probe = x_probe[0] if len(x_probe) == 1 else None
                if isinstance(x_probe, torch.Tensor) and x_probe.dim() == 2:
                    input_data.kwargs["perTokenScaleOptional"] = [
                        torch.ones(
                            (int(x_probe.shape[0]), 1), dtype=torch.float32
                        )
                    ]

            # groupListType 0/1/2 materialisation
            group_list_type = case_scalar("groupListType")
            group_list_tensor = runtime_value("groupListOptional")
            group_list = _prepare_grouped_matmul_v5_group_list(
                runtime_value("x"), runtime_value("weight"), group_list_tensor,
                group_type, group_list_type
            )
            if group_list is not group_list_tensor:
                replace_runtime_value("groupListOptional", group_list)

            if input_data.kwargs:
                input_data.kwargs.pop("activationFeatureOutOptional", None)
                input_data.kwargs.pop("dynQuantScaleOutOptional", None)
            return


    def parse_operator_params(self, func_signature: str):
        params_match = re.search(r'\((.*?)\)\s*$', func_signature, re.DOTALL)
        if not params_match:
            return {}

        params_str = params_match.group(1)
        params = []
        current_param = ""
        angle_bracket_count = 0
        paren_count = 0

        for char in params_str:
            if char == '<':
                angle_bracket_count += 1
            elif char == '>':
                angle_bracket_count -= 1
            elif char == '(':
                paren_count += 1
            elif char == ')':
                paren_count -= 1
            elif char == ',' and angle_bracket_count == 0 and paren_count == 0:
                params.append(current_param.strip())
                current_param = ""
                continue
            current_param += char

        if current_param.strip():
            params.append(current_param.strip())

        result = {}
        for param in params:
            match = re.match(r'^(const\s+)?(.+?)\s+(\*?\s*)([a-zA-Z_][a-zA-Z0-9_]*)(\s*=\s*.*)?$', param.strip())
            if match:
                param_type = match.group(2).strip()
                param_name = match.group(4).strip()
                param_type = param_type.replace('const ', '').replace('const', '').strip()
                param_type = param_type.replace('*', '').strip()
                result[param_name] = param_type
        return result

    def get_config_by_name(self, configs, target_name: str):
        for item in configs:
            if isinstance(item, list):
                if item and hasattr(item[0], 'name') and item[0].name == target_name:
                    return item
            elif hasattr(item, 'name') and item.name == target_name:
                return item
        return None

    def _unwrap_config(self, name):
        found = self.get_config_by_name(
            self.task_result.case_config.inputs, name
        )
        if isinstance(found, (list, tuple)):
            found = found[0] if found else None
        return found

    def _int4_config_dtype(self, name):
        found = self._unwrap_config(name)
        return getattr(found, "dtype", None) if found is not None else None

    def _create_int4_acl_tensor(self, tensor, name):
        """Pack an int8 tensor (values in [-8, 7]) into an ACL_INT4 tensor.

        存储格式沿用 cases 配置的 format（ND/NZ）；storage_shape 缺省取
        tensor.shape（逻辑 shape），ACL_INT4 按 2 nibble/byte 计算物理
        存储大小，无需压缩末维。

        weight_transposed 物化（末两维转置视图）：ACL 视图 shape 恒为
        (E,K,N)（dim1=K 与 x 对齐），转置语义由 strides 表达（宿主
        IsTransposeLastTwoDims 判定 transposeWeight）；nibble 打包按物理
        存储顺序（视图再转置回 contiguous 的数据），shape/strides 按视图
        报告。ATK 自带的 create_int4_acl_tensor 会 contiguous() 重排数据
        破坏该对应关系，转置视图必须走本地打包路径。
        """
        found = self._unwrap_config(name)
        fmt = AclFormat.ACL_FORMAT_ND
        config_format = getattr(found, "format", None) if found else None
        if config_format:
            fmt = self.get_acl_format(config_format)
        view = tensor
        pack_src = tensor
        if (isinstance(view, torch.Tensor) and view.dim() >= 2
                and not view.is_contiguous()):
            pack_src = view.transpose(-1, -2).contiguous()
        return self._pack_int4_acl_tensor(view, pack_src, fmt)

    def _pack_int4_acl_tensor(self, view, pack_src, fmt):
        """Pack pack_src data as ACL_INT4, reporting view's shape/strides."""
        if pack_src.device.type != 'npu':
            pack_src = pack_src.npu().clone()
        if pack_src.dtype != torch.int8:
            raise TypeError(
                f"int4 input data must be torch.int8, but got {pack_src.dtype}"
            )
        if not torch.all((pack_src >= -8) & (pack_src <= 7)):
            num_bad = torch.sum((pack_src < -8) | (pack_src > 7)).item()
            raise ValueError(
                f"int4 input data contains {num_bad} values out of int4 "
                "range [-8, 7]"
            )

        dtype = AclDataType.ACL_INT4
        t_flat = pack_src.contiguous().view(-1).clone().npu()
        t_flat[t_flat < 0] += 16  # 补码表示
        if t_flat.numel() % 2 != 0:
            t_flat = torch.cat(
                [t_flat, torch.zeros(1, dtype=torch.int8).npu()], dim=0
            )
        low = t_flat[0::2]
        high = t_flat[1::2]
        packed = (high << 4) | low
        packed = packed.to(torch.uint8)
        nnopbase.int4_cache.append(packed)

        device_addr = ctypes.c_void_p(packed.data_ptr())
        view_shape = tuple(int(v) for v in view.shape)
        view_strides = tuple(int(s) for s in view.stride())
        storage_shape = view_shape
        acl_tensor = nnopbase.aclCreateTensor(
            (Int64 * len(view_shape))(*view_shape), len(view_shape),
            dtype, (Int64 * len(view_strides))(*view_strides), 0, fmt,
            (Int64 * len(storage_shape))(*storage_shape),
            len(storage_shape), device_addr
        )
        if not acl_tensor:
            raise RuntimeError("aclCreateTensor returned nullptr")
        return AclTensorStruct(acl_tensor, device_addr.value, view, 1)

    def get_acl_format(self, format_str):
        FORMAT_MAPPING = {
            'ND': AclFormat.ACL_FORMAT_ND,
            'NZ': AclFormat.ACL_FORMAT_FRACTAL_NZ,
            'NCHW': AclFormat.ACL_FORMAT_NCHW,
            'NC': AclFormat.ACL_FORMAT_NC,
            'HWCN': AclFormat.ACL_FORMAT_HWCN,
            'NHWC': AclFormat.ACL_FORMAT_NHWC,
            'NC1HWC0': AclFormat.ACL_FORMAT_NC1HWC0,
            'NDC1HWC0': AclFormat.ACL_FORMAT_NDC1HWC0,
            'NCL': AclFormat.ACL_FORMAT_NCL,
            'NCDHW': AclFormat.ACL_FORMAT_NCDHW,
            'NDHWC': AclFormat.ACL_FORMAT_NDHWC,
            'FRACTAL_Z_3D': AclFormat.ACL_FRACTAL_Z_3D,
        }
        if format_str in FORMAT_MAPPING:
            return FORMAT_MAPPING[format_str]
        else:
            logging.error(f"not found format: {format_str}")
            return AclFormat.ACL_FORMAT_ND

