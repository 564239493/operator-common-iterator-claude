    def _int4_config_dtype(self, name):
        found = self._unwrap_config(name)
        return getattr(found, "dtype", None) if found is not None else None

    def _create_int4_acl_tensor(self, tensor, name):
        """Pack an int8 tensor (values in [-8, 7]) into an ACL_INT4 tensor.

        存储格式沿用 cases 配置的 format（ND/NZ）；storage_shape 缺省取
        tensor.shape（逻辑 shape），ACL_INT4 按 2 nibble/byte 计算物理
        存储大小，无需压缩末维。

        weight_transposed 物化（末两维转置视图）：ACL 视图 shape 恒为
        (E,K,N)（dim1=K 与 x 对齐），转置语义由 strides 表达（宿主
        IsTransposeLastTwoDims 判定 transposeWeight）；nibble 打包按物理
        存储顺序（视图再转置回 contiguous 的数据），shape/strides 按视图
        报告。ATK 自带的 create_int4_acl_tensor 会 contiguous() 重排数据
        破坏该对应关系，转置视图必须走本地打包路径。
        """
        found = self._unwrap_config(name)
        fmt = AclFormat.ACL_FORMAT_ND
        config_format = getattr(found, "format", None) if found else None
        if config_format:
            fmt = self.get_acl_format(config_format)
        view = tensor
        pack_src = tensor
        if (isinstance(view, torch.Tensor) and view.dim() >= 2
                and not view.is_contiguous()):
            pack_src = view.transpose(-1, -2).contiguous()
        return self._pack_int4_acl_tensor(view, pack_src, fmt)

    def _pack_int4_acl_tensor(self, view, pack_src, fmt):
        """Pack pack_src data as ACL_INT4, reporting view's shape/strides."""
        if pack_src.device.type != 'npu':
            pack_src = pack_src.npu().clone()
        if pack_src.dtype != torch.int8:
            raise TypeError(
                f"int4 input data must be torch.int8, but got {pack_src.dtype}"
            )
        if not torch.all((pack_src >= -8) & (pack_src <= 7)):
            num_bad = torch.sum((pack_src < -8) | (pack_src > 7)).item()
            raise ValueError(
                f"int4 input data contains {num_bad} values out of int4 "
                "range [-8, 7]"
            )

        dtype = AclDataType.ACL_INT4
        t_flat = pack_src.contiguous().view(-1).clone().npu()
        t_flat[t_flat < 0] += 16  # 补码表示
        if t_flat.numel() % 2 != 0:
            t_flat = torch.cat(
                [t_flat, torch.zeros(1, dtype=torch.int8).npu()], dim=0
            )
        low = t_flat[0::2]
        high = t_flat[1::2]
        packed = (high << 4) | low
        packed = packed.to(torch.uint8)
        nnopbase.int4_cache.append(packed)

        device_addr = ctypes.c_void_p(packed.data_ptr())
        view_shape = tuple(int(v) for v in view.shape)
        view_strides = tuple(int(s) for s in view.stride())
        storage_shape = view_shape
        acl_tensor = nnopbase.aclCreateTensor(
            (Int64 * len(view_shape))(*view_shape), len(view_shape),
            dtype, (Int64 * len(view_strides))(*view_strides), 0, fmt,
            (Int64 * len(storage_shape))(*storage_shape),
            len(storage_shape), device_addr
        )
        if not acl_tensor:
            raise RuntimeError("aclCreateTensor returned nullptr")
        return AclTensorStruct(acl_tensor, device_addr.value, view, 1)

    def get_acl_format(self, format_str):
        FORMAT_MAPPING = {
            'ND': AclFormat.ACL_FORMAT_ND,
            'NZ': AclFormat.ACL_FORMAT_FRACTAL_NZ,
            'NCHW': AclFormat.ACL_FORMAT_NCHW,
            'NC': AclFormat.ACL_FORMAT_NC,
            'HWCN': AclFormat.ACL_FORMAT_HWCN,
            'NHWC': AclFormat.ACL_FORMAT_NHWC,
            'NC1HWC0': AclFormat.ACL_FORMAT_NC1HWC0,
            'NDC1HWC0': AclFormat.ACL_FORMAT_NDC1HWC0,
            'NCL': AclFormat.ACL_FORMAT_NCL,
            'NCDHW': AclFormat.ACL_FORMAT_NCDHW,
            'NDHWC': AclFormat.ACL_FORMAT_NDHWC,
            'FRACTAL_Z_3D': AclFormat.ACL_FRACTAL_Z_3D,
        }
        if format_str in FORMAT_MAPPING:
            return FORMAT_MAPPING[format_str]
        else:
            logging.error(f"not found format: {format_str}")
            return AclFormat.ACL_FORMAT_ND

    def get_ctype(self, type_str):
        PYTYPE_TO_CTYPE = {
            "float": ctypes.c_float,
            "float32": ctypes.c_float,
            "float64": ctypes.c_double,
            "fp": ctypes.c_float,
            "fp32": ctypes.c_float,
            "fp64": ctypes.c_double,
            "double": ctypes.c_double,
            "int": ctypes.c_int64,
            "int8_t": ctypes.c_int8,
            "int8": ctypes.c_int8,
            "int32_t": ctypes.c_int32,
            "int32": ctypes.c_int32,
            "int64_t": ctypes.c_int64,
            "int64": ctypes.c_int64,
            "uint8_t": ctypes.c_uint8,
            "uint8": ctypes.c_uint8,
            "uint32_t": ctypes.c_uint32,
            "uint32": ctypes.c_uint32,
            "uint64_t": ctypes.c_uint64,
            "uint64": ctypes.c_uint64,
            "bool": ctypes.c_bool,
            "attr_bool": ctypes.c_bool,
            "str": ctypes.c_char_p,
            "string": ctypes.c_char_p,
        }
        if type_str in PYTYPE_TO_CTYPE:
            return PYTYPE_TO_CTYPE[type_str]
        else:
            raise ValueError(f"Unsupported CTYPE format: {type_str}")


