            isinstance(_x_probe, torch.Tensor)
            and _x_probe.dtype == torch.int8
            and isinstance(_weight_probe, torch.Tensor)
            and _weight_probe.dtype == torch.int32
            and not _is_a16w8
            and not _is_a8w8
            and not _is_a4w4
        )
        _quant_x = _is_a8w8 or _is_a4w4 or _is_a8w4

        def _a8w8_scale_single():
            """Unwrap scaleOptional to a single [E,N]/[E,1] tensor, or None."""
            tensor = _scale
            if isinstance(tensor, (list, tuple)):
                if len(tensor) == 1 and isinstance(tensor[0], torch.Tensor):
                    return tensor[0]
                raise ValueError(
                    "GroupedMatmulV5 A8W8 expects a single scaleOptional, "
                    f"got {len(tensor)} entries"
                )
            if tensor is None:
                return None
            if not isinstance(tensor, torch.Tensor):
                raise ValueError(
                    "GroupedMatmulV5 scaleOptional must be a tensor"
                )
            return tensor

        def _a8w8_scale_value():
            """Broadcast scaleOptional onto the matmul weight layout [E,K,N].

            perchannel [E,N] -> [E,1,N]; pertensor [E,1] -> [E,1,1].
            """
            tensor = _a8w8_scale_single()
            if tensor is None:
                return None
            value = tensor.float()
            if value.dim() == 1:
                value = value.unsqueeze(0)
            if value.dim() != 2:
                raise ValueError(
                    "GroupedMatmulV5 A8W8 scaleOptional must be rank-2 "
                    f"[E,N]/[E,1], got {tuple(value.shape)}"
                )
            return value.unsqueeze(-2)

        def _a8w8_out_dtype():
            """A8W8 out dtype follows the doc scale/perTokenScale combo table."""
            tensor = _a8w8_scale_single()
            if tensor is None:
                return torch.int32
            if tensor.dtype == torch.uint64:
                return torch.int8
            if tensor.dtype == torch.bfloat16:
                return torch.bfloat16
            if tensor.dtype in (torch.float32, torch.float64):
                return torch.float16
            raise ValueError(
                "GroupedMatmulV5 A8W8 unsupported scaleOptional dtype "
                f"{tensor.dtype}"
            )

        def _a8w4_out_dtype():
            """A8W4 out dtype follows the doc table (BFLOAT16/FLOAT16).

            文档 A8W4 数据类型表：offset 为空 -> out BFLOAT16；offset 不为空
            -> out FLOAT16。以 case 配置的 out 输入项 dtype 为准（ATK 按其
            创建 NPU out 张量），缺省回退 BFLOAT16。
            """
            for _cfg in _flat_configs:
                if getattr(_cfg, "name", None) == "out":
                    _dt = str(getattr(_cfg, "dtype", "") or "").lower()
                    return {
                        "fp16": torch.float16,
                        "float16": torch.float16,
                        "bf16": torch.bfloat16,
                        "bfloat16": torch.bfloat16,
                        "fp32": torch.float32,
                        "float32": torch.float32,
                    }.get(_dt, torch.bfloat16)
            return torch.bfloat16

        def _dequant_x(x_tensor, start=None, end=None):
            """Dequantise quantized x (A8W8 INT8 / A4W4 INT4) by perTokenScale rows."""
            if _is_a4w4:
                value = _int4_nibble_wrap(x_tensor).float()
            else:
                value = x_tensor.float()
            if _per_token_scale is None:
                return value
            tensor = _per_token_scale
            if isinstance(tensor, (list, tuple)):
                if len(tensor) == 1 and isinstance(tensor[0], torch.Tensor):
                    tensor = tensor[0]
                else:
                    raise ValueError(
                        "GroupedMatmulV5 perTokenScaleOptional must be a "
                        "single tensor"
                    )
            if not isinstance(tensor, torch.Tensor):
                raise ValueError(
                    "GroupedMatmulV5 perTokenScaleOptional must be a tensor"
                )
            rows = tensor.float().reshape(-1)
            if start is not None:
                rows = rows[start:end]
            if rows.numel() != value.shape[0]:
                raise ValueError(
                    "GroupedMatmulV5 perTokenScaleOptional length must match "
                    f"M (got {rows.numel()}, expected {value.shape[0]})"
                )
            return value * rows.reshape(-1, 1)

        def _dequant_weight(w_tensor, scale, offset):
            if _is_a16w8:
                w_matmul = _grouped_matmul_v5_weight_for_matmul(
                    w_tensor, _group_type, _weight_transposed
                )
                w_matmul = _grouped_matmul_v5_dequant_perchannel(
                    w_matmul, scale, offset
                )
                return w_matmul.float()
            # 非量化场景：weight 为浮点类型（FLOAT32/FLOAT16/BFLOAT16），
            # 直接按 weight_transposed 转为 matmul 布局，不做 INT4 unpack。
            if isinstance(w_tensor, torch.Tensor) and w_tensor.dtype in (
                torch.float16,
                torch.bfloat16,
                torch.float32,
            ):
                w_matmul = _grouped_matmul_v5_weight_for_matmul(
                    w_tensor, _group_type, _weight_transposed
                )
                return w_matmul.float()
            # A8W8 全量化：weight 为 INT8，每个存储元素即一个逻辑值。
            # 先按 weight_transposed 恢复 matmul 布局（(E,N,K)→(E,K,N)），
            # 再按 scaleOptional（perchannel [E,N]/pertensor [E,1]）反量化；
            # 严禁对 INT8 weight 做 nibble unpack。
            if isinstance(w_tensor, torch.Tensor) and w_tensor.dtype == torch.int8:
                w_matmul = _grouped_matmul_v5_weight_for_matmul(
                    w_tensor, _group_type, _weight_transposed
                )
                value = w_matmul.float()
                scale_value = _a8w8_scale_value()
                if scale_value is not None:
                    value = value * scale_value
                return value
            # A4W4 / INT4: ATK 以 torch.int32 逻辑值（每元素一个 nibble 值、
            # 逻辑 shape）生成 int4 数据，CPU golden 不做 nibble unpack；
            # cases 层 weight 逻辑 shape 恒为 (E,K,N)，weight_transposed 仅是
            # NPU 侧"先转置再 NZ"的物化标识，CPU 侧无需转置。折算到 [-8,7]
            # 后按 scaleOptional（perchannel [E,N] / pergroup [E,G,N]）反量化。
            # A8W4 伪量化多 Tensor 场景：scaleOptional 与 weight TensorList
            # 等长，逐 tensor 形态为 2 维 [quantGroupNum,N]（offset 为空，
            # quantGroupNum=K/256）/[1,N]（offset 不为空）——必须使用调用方
            # 传入的逐 tensor scale 入参，禁止调用 _a8w8_scale_single() 解包
            # 全局 scaleOptional（A8W8 单 Tensor 语义，len>1 时必然抛错）。
            # 入参缺失时仅当全局 scaleOptional 为单 Tensor 形态才回退
            # （A4W4 单 Tensor 路径）；多 Tensor 列表无当前 tensor 索引，
            # 无法在此取值，跳过回退。
            if isinstance(w_tensor, torch.Tensor) and w_tensor.dtype == torch.int32:
                w_matmul = _int4_nibble_wrap(w_tensor).float()
                if w_matmul.dim() not in (2, 3):
                    raise ValueError(
                        f"Unsupported INT4 weight rank {w_matmul.dim()}"
                    )
                scale_arg = scale
                if scale_arg is None:
                    _global_scale = _scale
                    if isinstance(_global_scale, (list, tuple)):
                        if (len(_global_scale) == 1
                                and isinstance(_global_scale[0], torch.Tensor)):
                            scale_arg = _global_scale[0]
                    elif isinstance(_global_scale, torch.Tensor):
                        scale_arg = _global_scale
                if scale_arg is not None:
                    if not isinstance(scale_arg, torch.Tensor):
                        raise TypeError(
                            "GroupedMatmulV5 INT4 scaleOptional must be a "
                            "tensor"
                        )
                    scale_value = scale_arg.float()
                    if w_matmul.dim() == 2 and scale_value.dim() == 2:
                        # A8W4 多 Tensor per-expert：weight [K,N] +
                        # scale [quantGroupNum,N]/[1,N]，统一升维为
                        # [1,K,N]/[1,G,N] 复用 pergroup 广播后降回。
                        scale_value = _grouped_matmul_v5_a4w4_scale(
                            scale_value.unsqueeze(0), w_matmul.unsqueeze(0)
                        ).squeeze(0)
                    else:
                        scale_value = _grouped_matmul_v5_a4w4_scale(
                            scale_value, w_matmul
                        )
                    if scale_value is not None:
                        w_matmul = w_matmul * scale_value
                return w_matmul
            # 显式拒绝未知 dtype：不再默认落入 INT4 unpack 分支。
            raise ValueError(
                "GroupedMatmulV5 CPU golden unsupported weight dtype "
                f"{getattr(w_tensor, 'dtype', type(w_tensor).__name__)}: "
                "expected float16/bfloat16/float32 (non-quant), int8 (A8W8) "
                "or int32 (INT4 logical values)"
            )

        def _group_slices(group_list_t, gl_type, e_count, m_total, device):
            tensor = group_list_t
            if tensor is None or not isinstance(tensor, torch.Tensor):
                tensor = _build_grouped_matmul_v5_group_list(
                    m_total, e_count, gl_type, device
                )
            tensor = tensor.to(device=device, dtype=torch.int64)
            try:
                if gl_type == 0:
                    ends = tensor.tolist()
                    if len(ends) != e_count:
                        raise ValueError("groupList length mismatch")
                    starts = [0] + ends[:-1]
                    indexes = list(range(e_count))
                elif gl_type == 1:
                    sizes = tensor.tolist()
                    if len(sizes) != e_count:
                        raise ValueError("groupList length mismatch")
                    ends, acc = [], 0
                    for s in sizes:
                        acc += s
                        ends.append(acc)
                    starts = [0] + ends[:-1]
                    indexes = list(range(e_count))
                else:  # type 2
                    pairs = tensor.tolist()
                    if len(pairs) != e_count:
                        raise ValueError("groupList length mismatch")
                    sizes = [0] * e_count
                    for pair in pairs:
                        idx = int(pair[0])
                        if 0 <= idx < e_count:
                            sizes[idx] = int(pair[1])
                    ends, acc, starts = [], 0, []
                    for s in sizes:
                        starts.append(acc)
                        acc += s
                        ends.append(acc)
                    indexes = list(range(e_count))
            except (ValueError, TypeError, IndexError):
                tensor = _build_grouped_matmul_v5_group_list(
                    m_total, e_count, gl_type, device
                )
                if gl_type == 0:
                    ends = tensor.tolist()
                    starts = [0] + ends[:-1]
                    indexes = list(range(e_count))
                elif gl_type == 1:
                    ends = torch.cumsum(tensor, dim=0).tolist()
                    starts = [0] + ends[:-1]
                    indexes = list(range(e_count))
                else:
                    indexes = tensor[:, 0].tolist()
                    ends = torch.cumsum(tensor[:, 1], dim=0).tolist()
                    starts = [0] + ends[:-1]
            return list(zip(starts, ends, indexes))

        # ====================================================================
        # groupType == -1: no grouping, multi-tensorList, per-group matmul
        # ====================================================================
        if _group_type == -1:
            x_list = _as_list(_x) or []
            weight_list = _as_list(_weight) or []
            scale_list = _as_list(_antiquant_scale)
            offset_list = _as_list(_antiquant_offset)
            bias_list = _as_list(_bias)
            out_dtype = x_list[0].dtype if x_list else torch.float16
            if _is_a8w8:
                out_dtype = _a8w8_out_dtype()
            elif _is_a4w4:
                out_dtype = torch.float16
            results = []
            for i, xi in enumerate(x_list):
                wi = weight_list[i] if i < len(weight_list) else None
                if wi is None:
                    raise ValueError(
                        f"GroupedMatmulV5 groupType=-1 missing weight[{i}]"
                    )
                si = scale_list[i] if scale_list and i < len(scale_list) else None
                oi = offset_list[i] if offset_list and i < len(offset_list) else None
                dw = _dequant_weight(wi, si, oi)
                x_value = _dequant_x(xi) if _quant_x else xi.float()
                yi = torch.matmul(x_value, dw)
                if bias_list and i < len(bias_list) and bias_list[i] is not None:
                    yi = yi + bias_list[i].float()
                results.append(yi.to(out_dtype))
            return results

        # ====================================================================
        # groupType == 0: M-axis grouping, single out
        # ====================================================================
        if _group_type == 0:
            weight_single = _unwrap_single(_weight)
            x_single = _unwrap_single(_x)
            bias_single = _unwrap_single(_bias)
            # 量化场景（A8W4/A8W8/A4W4）scale 取自 scaleOptional；A16W8/A16W4
            # 伪量化才使用 antiquantScaleOptional（量化场景下恒为 None）。
            # 显式 None 判断：tensor 不允许参与 or 真值运算（多元素 Tensor
            # 触发 Boolean value of Tensor is ambiguous）。
            scale_single = _unwrap_single(_scale)
            if scale_single is None:
                scale_single = _unwrap_single(_antiquant_scale)
            offset_single = _unwrap_single(_antiquant_offset)

            multi_weight = isinstance(weight_single, (list, tuple))
            if multi_weight:
                weight_list = list(weight_single)
                e_count = len(weight_list)
                # 逐 tensor scale 传参源：量化场景（A8W4 伪量化多 Tensor）
                # 取自 scaleOptional（与 weight TensorList 等长）；A16W8/A16W4
                # 伪量化才回退 antiquantScaleOptional。原实现错接
                # antiquantScaleOptional 导致 A8W4 场景逐 tensor scale 恒 None。
                scale_list = (
                    _as_list(_scale) or _as_list(_antiquant_scale)
                    or [None] * e_count
                )
                offset_list = _as_list(_antiquant_offset) or [None] * e_count
                bias_list = _as_list(_bias) or [None] * e_count
                x_list = _as_list(_x)
                out_dtype = (
                    x_list[0].dtype if x_list else torch.float16
                )
                if _is_a8w8:
                    out_dtype = _a8w8_out_dtype()
                elif _is_a4w4:
                    out_dtype = torch.float16
                elif _is_a8w4:
                    out_dtype = _a8w4_out_dtype()
                # Multi-x: each x_i is already a chunk
                if x_list is not None and len(x_list) == e_count:
                    group_outputs = []
                    for e in range(e_count):
                        dw = _dequant_weight(
                            weight_list[e],
                            scale_list[e] if e < len(scale_list) else None,
                            offset_list[e] if e < len(offset_list) else None,
                        )
                        x_value = (
                            _dequant_x(x_list[e]) if _quant_x
                            else x_list[e].float()
                        )
                        yi = torch.matmul(x_value, dw)
                        b = bias_list[e] if e < len(bias_list) else None
                        if b is not None:
                            yi = yi + b.float()
                        group_outputs.append(yi)
                    result = torch.cat(group_outputs, dim=0)
                    return result.to(out_dtype)
                # Single x: slice by groupList
                x_tensor = x_single if isinstance(x_single, torch.Tensor) else (
                    x_list[0] if x_list else None
                )
                if x_tensor is None:
                    raise ValueError(
                        "GroupedMatmulV5 groupType=0 missing x tensor"
                    )
                m_total = x_tensor.shape[0]
                slices = _group_slices(
                    _group_list_tensor, _group_list_type, e_count,
                    m_total, x_tensor.device,
                )
                group_outputs = []
                for start, end, w_idx in slices:
                    x_group = x_tensor[start:end]
                    dw = _dequant_weight(
                        weight_list[w_idx],
                        scale_list[w_idx] if w_idx < len(scale_list) else None,
                        offset_list[w_idx] if w_idx < len(offset_list) else None,
                    )
                    x_value = (
                        _dequant_x(x_group, start, end) if _quant_x
                        else x_group.float()
                    )
                    yi = torch.matmul(x_value, dw)
                    b = bias_list[w_idx] if w_idx < len(bias_list) else None
                    if b is not None:
                        yi = yi + b.float()
                    group_outputs.append(yi)
                result = torch.cat(group_outputs, dim=0)
                return result.to(out_dtype)

            # Single 3-D weight [E, K, N]
            if not isinstance(weight_single, torch.Tensor):
                raise ValueError(
                    "GroupedMatmulV5 groupType=0 single-weight requires a 3-D "
                    "weight tensor"
                )
            w3 = weight_single
            x_tensor = x_single if isinstance(x_single, torch.Tensor) else (
                _as_list(_x)[0] if _as_list(_x) else None
            )
            if x_tensor is None:
                raise ValueError(
                    "GroupedMatmulV5 groupType=0 missing x tensor"
                )
            e_count = w3.shape[0]
            m_total = x_tensor.shape[0]
            # A8W8 输出 dtype 由 scale/perTokenScale 组合表决定
            # （uint64→INT8 / bf16→BF16 / float→FLOAT16 / 无 scale→INT32）；
            # A4W4 输出 dtype 固定 FLOAT16/BFLOAT16，取 FLOAT16；
            # A8W4 输出 dtype 按 case 配置（BFLOAT16/FLOAT16）。
            if _is_a8w8:
                out_dtype = _a8w8_out_dtype()
            elif _is_a4w4:
                out_dtype = torch.float16
            elif _is_a8w4:
                out_dtype = _a8w4_out_dtype()
            else:
                out_dtype = x_tensor.dtype
            dw3 = _dequant_weight(w3, scale_single, offset_single)
            bias_2d = bias_single if isinstance(bias_single, torch.Tensor) else None
            slices = _group_slices(
                _group_list_tensor, _group_list_type, e_count,
                m_total, x_tensor.device,
            )
            group_outputs = []
            for start, end, w_idx in slices:
                x_group = x_tensor[start:end]
                x_value = (
                    _dequant_x(x_group, start, end) if _quant_x
                    else x_group.float()
                )
                yi = torch.matmul(x_value, dw3[w_idx])
                if bias_2d is not None:
                    yi = yi + bias_2d[w_idx].float()
                group_outputs.append(yi)
            result = torch.cat(group_outputs, dim=0)
            return result.to(out_dtype)

        # ====================================================================
        # groupType == 2: K-axis grouping
        # ====================================================================
        if _group_type == 2:
            x_list = _as_list(_x) or []
            weight_list = _as_list(_weight) or []
            bias_list = _as_list(_bias)
            scale_list = _as_list(_antiquant_scale)
            offset_list = _as_list(_antiquant_offset)
            out_dtype = x_list[0].dtype if x_list else torch.float16
            if _is_a8w8:
                out_dtype = _a8w8_out_dtype()
            elif _is_a4w4:
                out_dtype = torch.float16

            results = []
            for i, xi in enumerate(x_list):
                wi = weight_list[i] if i < len(weight_list) else None
                if wi is None:
                    raise ValueError(
                        f"GroupedMatmulV5 groupType=2 missing weight[{i}]"
                    )
                si = scale_list[i] if scale_list and i < len(scale_list) else None
                oi = offset_list[i] if offset_list and i < len(offset_list) else None
                if _is_a16w8:
                    dw = _grouped_matmul_v5_dequant_perchannel(wi, si, oi)
                elif isinstance(wi, torch.Tensor) and wi.dtype in (
                    torch.float16,
                    torch.bfloat16,
                    torch.float32,
                ):
                    # 非量化场景：浮点 weight 直接转 matmul 布局，不做 INT4 unpack
                    dw = _grouped_matmul_v5_weight_for_matmul(
                        wi, _group_type, _weight_transposed
                    )
                elif isinstance(wi, torch.Tensor) and wi.dtype == torch.int8:
                    # A8W8 K-axis：INT8 weight 每元素即一个逻辑值，
                    # 恢复 matmul 布局后按 scaleOptional 反量化，禁止 nibble unpack。
                    dw = _grouped_matmul_v5_weight_for_matmul(
                        wi, _group_type, _weight_transposed
                    ).float()
                    scale_value = _a8w8_scale_value()
                    if scale_value is not None:
                        dw = dw * scale_value
                elif isinstance(wi, torch.Tensor) and wi.dtype == torch.int32:
                    # A4W4 K-axis: int32 逻辑值折算 + scaleOptional 反量化，
                    # 不做 nibble unpack，逻辑 shape 即 matmul 布局。
                    dw = _dequant_weight(wi, si, oi)
                else:
                    # 显式拒绝未知 dtype：不再默认落入 INT4 unpack 分支。
                    raise ValueError(
                        "GroupedMatmulV5 CPU golden unsupported weight dtype "
                        f"{getattr(wi, 'dtype', type(wi).__name__)} at "
                        f"groupType=2 weight[{i}]"
                    )
                x_value = _dequant_x(xi) if _quant_x else xi.float()
                yi = torch.matmul(x_value, dw)
                if bias_list and i < len(bias_list) and bias_list[i] is not None:
                    yi = yi + bias_list[i].float()
                results.append(yi.to(out_dtype))
            return results

        # ====================================================================
        # Fallback: unsupported groupType
        # ====================================================================
        raise ValueError(
            f"GroupedMatmulV5 CPU golden unsupported groupType={_group_type}"
        )
