{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "ask",
      "runs/**": "allow",
      "agent/**": "ask",
      "executer/**": "deny",
      "**/executer/**": "deny",
      "agent/generators/**": "deny",
      "**/agent/generators/**": "deny",
      ".git/**": "deny",
      "**/.git/**": "deny",
      "servers.json": "deny",
      "**/servers.json": "deny",
      "run_state.json": "deny",
      "**/run_state.json": "deny",
      ".opencode/**": "ask",
      "docs/**": "ask",
      "knowledge/**": "ask",
      "scripts/**": "ask",
      "src/**": "ask",
      "prompts/**": "ask"
    },
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    },
    "bash": {
      "*": "allow",
      "pip install*": "ask",
      "pip3 install*": "ask",
      "pip uninstall*": "ask",
      "pip3 uninstall*": "ask",
      "python -m pip*": "ask",
      "python3 -m pip*": "ask",
      "python -m venv*": "ask",
      "python3 -m venv*": "ask",
      "uv add*": "ask",
      "uv remove*": "ask",
      "uv sync*": "ask",
      "uv pip*": "ask",
      "npm install*": "ask",
      "npm uninstall*": "ask",
      "npm i *": "ask",
      "npm i": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git pull*": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git clean*": "ask",
      "git stash*": "ask",
      "git tag*": "ask",
      "git rm*": "ask",
      "git mv*": "ask",
      "sudo *": "ask",
      "sudo": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "mv *": "ask",
      "move *": "ask",
      "del *": "ask",
      "erase *": "ask",
      "python /*": "ask",
      "python3 /*": "ask",
      "py /*": "ask",
      "git apply*": "ask",
      "git restore*": "ask",
      "rsync *": "ask",
      "node -e*": "deny",
      "node --eval*": "deny",
      "chmod *": "ask",
      "chown *": "ask",
      "kill *": "ask",
      "killall *": "ask",
      "pkill *": "ask",
      "taskkill *": "ask",
      "apt *": "ask",
      "apt-get *": "ask",
      "dnf *": "ask",
      "yum *": "ask",
      "winget *": "ask",
      "choco *": "ask",
      "source *": "ask",
      "eval *": "ask",
      "python -c*": "deny",
      "python3 -c*": "deny",
      "*python -c *": "deny",
      "*python3 -c *": "deny"
    }
  }
}
